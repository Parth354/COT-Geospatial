# SpatialMind Production Configuration
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/spatialdb
REDIS_URL=redis://127.0.0.1:6379/0
CELERY_BROKER_URL=redis://127.0.0.1:6379/0
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/0

# Production LLM API Configuration
# Option 1: Groq (Recommended - Free & Fast: https://console.groq.com/keys)
GROQ_API_KEY=

# Option 2: OpenAI (https://platform.openai.com/api-keys)
OPENAI_API_KEY=

# Option 3: Google Gemini (https://aistudio.google.com/app/apikey)
GOOGLE_API_KEY=

# Option 4: Anthropic Claude (https://console.anthropic.com/settings/keys)
ANTHROPIC_API_KEY=

# Active Provider: "auto", "gemini", "groq", "anthropic", or "openai"
LLM_PROVIDER=gemini

# Optional Geospatial Telemetry APIs (Can also be configured via UI Settings Panel)
# NASA FIRMS Map Key: https://firms.modaps.eosdis.nasa.gov/api/map_key/
NASA_FIRMS_API_KEY=

# OpenAQ API Key (v3): https://openaq.org/
OPENAQ_API_KEY=

# OpenWeatherMap API Key: https://openweathermap.org/api
OPENWEATHER_API_KEY=

# Mapbox Access Token: https://account.mapbox.com/
MAPBOX_TOKEN=

# Copernicus CDSE Key: https://dataspace.copernicus.eu/
COPERNICUS_API_KEY=
